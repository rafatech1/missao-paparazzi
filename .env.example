# E-mail da service account do Google Cloud (Drive API)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome-da-conta@seu-projeto.iam.gserviceaccount.com

# Chave privada da service account (arquivo JSON baixado do Google Cloud).
# Copie o valor do campo "private_key" do JSON, mantendo as quebras de linha como \n.
# Exemplo: "-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID da pasta do Google Drive onde as fotos vão ser salvas.
# É o trecho depois de /folders/ na URL da pasta.
GOOGLE_DRIVE_FOLDER_ID=coloque_o_id_da_pasta_aqui
