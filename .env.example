# Credenciais OAuth do Google (conta pessoal, não service account).
# Contas de serviço não têm cota de armazenamento no Drive, então o upload
# usa a sua própria conta do Google — veja o README para o passo a passo
# completo (criar o OAuth Client ID e rodar scripts/get-refresh-token.js).

GOOGLE_OAUTH_CLIENT_ID=algumacoisa.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=coloque_o_client_secret_aqui
GOOGLE_OAUTH_REFRESH_TOKEN=coloque_o_refresh_token_gerado_pelo_script_aqui

# ID da pasta do Google Drive (na sua conta pessoal) onde as fotos vão ser salvas.
# É o trecho depois de /folders/ na URL da pasta.
GOOGLE_DRIVE_FOLDER_ID=coloque_o_id_da_pasta_aqui
